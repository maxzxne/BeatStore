# Database
DATABASE_URL=sqlite:///./data/beatstore.db

# API Configuration  
VITE_API_URL=http://localhost:8000

# JWT Secret (generate a random string for production)
JWT_SECRET_KEY=your-secret-key-here

# Environment
ENVIRONMENT=production

# Telegram Bot (для Mini App)
TELEGRAM_BOT_TOKEN=ваш_bot_token_от_BotFather
TELEGRAM_BOT_USERNAME=ваш_bot_username
VITE_TELEGRAM_BOT_USERNAME=ваш_bot_username
MINI_APP_URL=https://your-domain.ngrok-free.dev
FRONTEND_URL=https://unvisited-eve-unadjusted.ngrok-free.dev

# Telegram уведомления для админа (chat_id можно получить через @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=ваш_chat_id_для_уведомлений

# Payments — Robokassa. Empty MerchantLogin in test = public demo shop (auth.robokassa.ru).
# Live: set your shop login + passwords and PAYMENT_TEST=false. Same code path.
PAYMENT_PROVIDER=robokassa
PAYMENT_TEST=true
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=password_1
ROBOKASSA_PASSWORD2=password_2
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000